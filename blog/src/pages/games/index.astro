---
import Base from "../../layouts/Base.astro";
import GameCard from "../../components/GameCard.astro";
import { getCollection } from "astro:content";

const allDiaries = await getCollection("game-diary");
const diaries = allDiaries.sort(
  (a, b) =>
    (b.data.updatedAt?.getTime() || b.data.date.getTime()) -
    (a.data.updatedAt?.getTime() || a.data.date.getTime())
);
---

<Base title="Games - Daily" activeNav="games">
  <section class="page-header">
    <h1>Game Diary</h1>
    <p>我玩过的游戏，按我的标准记录。</p>
    <div class="status-tabs" id="status-tabs">
      <button class="tab active" data-status="">Timeline</button>
      <button class="tab" data-status="在玩">
        <span class="dot playing" /> Playing
      </button>
      <button class="tab" data-status="已通关">
        <span class="dot completed" /> Completed
      </button>
      <button class="tab" data-status="搁置">
        <span class="dot shelved" /> Shelved
      </button>
      <button class="tab" data-status="弃坑">
        <span class="dot dropped" /> Dropped
      </button>
    </div>
  </section>

  <div class="game-list" id="game-list">
    {
      diaries.map((entry) => (
        <div class="game-item" data-status={entry.data.myRecord.status}>
          <GameCard entry={entry} />
        </div>
      ))
    }
  </div>

  <div class="no-results" id="no-results" style="display:none;">
    <p>No games with this status.</p>
  </div>
</Base>

<style>
  .page-header {
    padding: 32px 0 20px;
  }
  .page-header h1 {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  .page-header p {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-bottom: 20px;
  }

  .status-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .tab {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .tab:hover {
    border-color: #4a4a4e;
    color: var(--text);
  }
  .tab.active {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
    font-weight: 500;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot.playing { background: #60a5fa; }
  .dot.completed { background: #4ade80; }
  .dot.shelved { background: #facc15; }
  .dot.dropped { background: #f87171; }

  .game-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 20px;
  }

  .game-item {
    transition: all 0.15s;
  }

  .no-results {
    text-align: center;
    padding: 48px 0;
    color: var(--text-dim);
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  const tabs = document.getElementById("status-tabs")!;
  const gameList = document.getElementById("game-list")!;
  const noResults = document.getElementById("no-results")!;
  const items = gameList.querySelectorAll<HTMLDivElement>(".game-item");

  tabs.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("button");
    if (!btn) return;

    tabs.querySelectorAll(".tab").forEach((t) => t.classList.remove("active"));
    btn.classList.add("active");

    const status = btn.dataset.status || "";
    let visible = 0;

    items.forEach((item) => {
      if (!status || item.dataset.status === status) {
        item.classList.remove("hidden");
        visible++;
      } else {
        item.classList.add("hidden");
      }
    });

    noResults.style.display = visible === 0 ? "" : "none";
  });
</script>
