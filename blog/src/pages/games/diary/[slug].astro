---
import Base from "../../../layouts/Base.astro";
import Tags from "../../../components/Tags.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const diaries = await getCollection("game-diary");
  return diaries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const score = d.myRecord.score;
const scoreColor =
  score >= 9
    ? "var(--score-great)"
    : score >= 7
      ? "var(--score-good)"
      : score >= 5
        ? "var(--score-mid)"
        : "var(--score-bad)";

const statusMap: Record<string, { cls: string; label: string }> = {
  "在玩": { cls: "playing", label: "Playing" },
  已通关: { cls: "completed", label: "Completed" },
  弃坑: { cls: "dropped", label: "Dropped" },
  搁置: { cls: "shelved", label: "Shelved" },
  想玩: { cls: "shelved", label: "Wishlist" },
};
const status = statusMap[d.myRecord.status] || {
  cls: "shelved",
  label: d.myRecord.status,
};

const dateStr = d.date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const updatedStr = d.updatedAt
  ? d.updatedAt.toLocaleDateString("zh-CN", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<Base title={`${d.game.cnName || d.game.name} - Game Diary`}>
  <article class="diary">
    <div class="hero-banner">
      {d.assets?.hero ? (
        <img src={`${import.meta.env.BASE_URL}${d.assets.hero}`} alt={d.game.cnName} />
      ) : d.assets?.cover ? (
        <img src={`${import.meta.env.BASE_URL}${d.assets.cover}`} alt={d.game.cnName} />
      ) : (
        <span class="placeholder">No Image</span>
      )}
    </div>

    <div class="diary-header">
      <h1>{d.title}</h1>
      <div class="game-meta">
        {d.game.cnName || d.game.name}
        {d.game.developers?.length
          ? ` · ${d.game.developers.join(", ")}`
          : ""}
      </div>

      <div class="header-row">
        <div class="score-big" style={`border-color: ${scoreColor};`}>
          <span style={`color: ${scoreColor}`}>{score}</span>
          <span class="score-max">/10</span>
        </div>

        <div class="header-details">
          <div class="detail-row">
            <span class={`status-badge ${status.cls}`}>{status.label}</span>
            <span class="detail-sep">·</span>
            <span>{d.myRecord.platform}</span>
            {d.myRecord.playtimeHours && (
              <>
                <span class="detail-sep">·</span>
                <span>{d.myRecord.playtimeHours}h</span>
              </>
            )}
            <span class="detail-sep">·</span>
            <span>{dateStr}</span>
            {updatedStr && updatedStr !== dateStr && (
              <span class="updated"> (updated {updatedStr})</span>
            )}
          </div>
          {d.myRecord.recommend !== undefined && (
            <div class="detail-row">
              {d.myRecord.recommend ? (
                <span class="recommend-yes">Recommended</span>
              ) : (
                <span class="recommend-no">Not Recommended</span>
              )}
            </div>
          )}
        </div>
      </div>

      <Tags tags={d.tags} />
    </div>

    <div class="info-grid">
      <div class="info-block">
        <h4>Developer</h4>
        <div class="value small">
          {d.game.developers?.join(", ") || "—"}
        </div>
      </div>
      <div class="info-block">
        <h4>Publisher</h4>
        <div class="value small">
          {d.game.publishers?.join(", ") || "—"}
        </div>
      </div>
      <div class="info-block">
        <h4>Release</h4>
        <div class="value small">{d.game.releaseDate || "—"}</div>
      </div>
      <div class="info-block">
        <h4>Platforms</h4>
        <div class="value small">{d.game.platforms?.join(", ") || "—"}</div>
      </div>
      {d.game.mcScore && (
        <div class="info-block">
          <h4>Metacritic</h4>
          <div class="value small mc-score">{d.game.mcScore}</div>
        </div>
      )}
      {d.game.hltb && (
        <div class="info-block hltb-block">
          <h4>HowLongToBeat</h4>
          <div class="value small hltb-grid">
            {d.game.hltb.main && (
              <span><strong>{d.game.hltb.main}h</strong> Main</span>
            )}
            {d.game.hltb.mainExtra && (
              <span><strong>{d.game.hltb.mainExtra}h</strong> Main+</span>
            )}
            {d.game.hltb.completionist && (
              <span><strong>{d.game.hltb.completionist}h</strong> 100%</span>
            )}
          </div>
        </div>
      )}
    </div>

    <div class="content-body">
      <Content />
    </div>

    {d.game.steamAppId && (
      <div class="steam-link">
        <a
          href={`https://store.steampowered.com/app/${d.game.steamAppId}`}
          target="_blank"
          rel="noopener"
        >
          View on Steam &rarr;
        </a>
      </div>
    )}
  </article>
</Base>

<style>
  .hero-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .diary {
    max-width: 720px;
    margin: 0 auto;
  }

  .diary-header {
    margin-bottom: 32px;
  }
  .diary-header h1 {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }

  .game-meta {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 20px;
  }

  .header-row {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 16px;
  }

  .score-big {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 3px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .score-big span {
    font-size: 1.4rem;
    font-weight: 700;
    font-family: var(--font-mono);
  }
  .score-max {
    font-size: 0.8rem !important;
    color: var(--text-dim) !important;
    font-weight: 400 !important;
  }

  .header-details {
    padding-top: 4px;
  }

  .detail-row {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 4px;
  }

  .detail-sep {
    opacity: 0.3;
  }

  .updated {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  .recommend-yes {
    color: var(--score-great);
    font-weight: 500;
    font-size: 0.85rem;
  }
  .recommend-no {
    color: var(--score-bad);
    font-weight: 500;
    font-size: 0.85rem;
  }

  .content-body {
    margin-top: 16px;
  }

  .mc-score {
    color: #f5c518;
    font-weight: 700;
    font-size: 1.1rem;
  }

  .hltb-block {
    grid-column: span 2;
  }
  .hltb-grid {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hltb-grid span {
    color: var(--text-dim);
  }
  .hltb-grid strong {
    color: var(--text);
    font-weight: 600;
  }

  .steam-link {
    margin-top: 48px;
    padding: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .info-grid {
      grid-template-columns: 1fr;
    }
    .diary-header h1 {
      font-size: 1.3rem;
    }
    .header-row {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
